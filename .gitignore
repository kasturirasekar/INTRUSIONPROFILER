# ==============================================================================
# Git Ignore - Cyber-Attack Network Intrusion Profiler Using Ensemble Learning
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments & distribution caches
.venv/
.venv*/
venv/
ENV/
env/
.cache/
.matplotlib_cache/
*.egg-info/
dist/
build/
eggs/
.eggs/

# Testing & Code Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter Notebooks
.ipynb_checkpoints/
*-checkpoint.ipynb

# Frontend / Node dependencies & build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS / Windows / Linux OS metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor configurations
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Environment configurations & local secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Runtime SQLite databases
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.db-journal
backend/data/*.db

# Large Model Checkpoints & Serialized Artifacts (>50MB / GitHub limits)
*.joblib
*.pkl
*.h5
*.model
*.onnx
outputs/models/*
!outputs/models/.gitkeep
backend/data/lab_models/*
!backend/data/lab_models/.gitkeep

# User-uploaded runtime datasets
backend/data/uploads/*
!backend/data/uploads/.gitkeep

# Compressed raw dataset archives (>100MB)
*.csv.gz
data/raw/
data/processed/*.csv.gz
data/processed/sample_binary_5k.csv
